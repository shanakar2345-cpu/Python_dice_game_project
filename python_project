import random

print("🎲 Dice Race Game 🎲")

# Scores for two dice
score1 = 0
score2 = 0

# Roll dice 5 times each
for i in range(5):
    die1 = random.randint(1, 6)
    die2 = random.randint(1, 6)
    print(f"Round {i+1}: Dice1 = {die1}, Dice2 = {die2}")

    score1 += die1
    score2 += die2

# Show totals
print("\nFinal Scores:")
print("Dice1 Total =", score1)
print("Dice2 Total =", score2)

# Decide winner
if score1 > score2:
    print("🏆 Dice1 wins!")
elif score2 > score1:
    print("🏆 Dice2 wins!")
else:
    print("🤝 It's a tie!")

print("\n✅ Game Over")
